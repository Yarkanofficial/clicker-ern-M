<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Click Arena</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Auth Page -->
    <div id="authPage" class="page active">
        <div class="auth-container">
            <div class="logo">
                <h1>🏆 Click Arena</h1>
                <p>💰 Click & Win</p>
            </div>
            <div class="auth-box">
                <div class="auth-tabs">
                    <button class="tab-btn active" data-tab="login">Login</button>
                    <button class="tab-btn" data-tab="register">Register</button>
                </div>
                
                <!-- Login Form -->
                <div id="loginForm" class="auth-form active">
                    <h3>Welcome Back</h3>
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" id="loginUsername" placeholder="Enter username">
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" id="loginPassword" placeholder="Enter password">
                    </div>
                    <button class="auth-btn" id="loginBtn">Login</button>
                    <p class="auth-error" id="loginError"></p>
                </div>

                <!-- Register Form -->
                <div id="registerForm" class="auth-form">
                    <h3>Create Account</h3>
                    <div class="form-group">
                        <label>Username</label>
                        <input type="text" id="regUsername" placeholder="Choose username">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" id="regEmail" placeholder="Enter email">
                    </div>
                    <div class="form-group">
                        <label>Password</label>
                        <input type="password" id="regPassword" placeholder="Min 6 characters">
                    </div>
                    <div class="form-group">
                        <label>Confirm Password</label>
                        <input type="password" id="regConfirm" placeholder="Confirm password">
                    </div>
                    <button class="auth-btn" id="registerBtn">Register</button>
                    <p class="auth-error" id="registerError"></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Game Page -->
    <div id="mainPage" class="page">
        <!-- Header -->
        <header class="main-header">
            <div class="user-info">
                <div class="user-avatar" id="userAvatar">U</div>
                <div>
                    <span class="username" id="mainUsername">User</span>
                    <span class="user-id" id="mainUserId">ID: 0000</span>
                </div>
            </div>
            <div class="header-balance">
                <span>USDT</span>
                <span id="headerBalance">0.00</span>
            </div>
        </header>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Click Section -->
            <div class="click-section">
                <div class="click-circle" id="clickCircle">
                    <span>CLICK</span>
                    <span>HERE</span>
                    <span class="click-count" id="clickCount">0</span>
                </div>
                <div class="click-stats">
                    <span>Today: <strong id="todayClicks">0</strong></span>
                    <span>Rank: <strong id="userRank">-</strong></span>
                </div>
            </div>

            <!-- Global Stats -->
            <div class="global-stats">
                <div class="stat-item">
                    <span class="stat-label">Total Clicks Today</span>
                    <span class="stat-value" id="globalClicks">0</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Time Left</span>
                    <span class="stat-value" id="globalTimer">--:--:--</span>
                </div>
            </div>

            <!-- Winners List -->
            <div class="winners-section">
                <h3>🏆 Today's Winners</h3>
                <div class="winners-list" id="winnersList">
                    <div class="winner-item"><span>#1</span><span>---</span><span>0 clicks</span></div>
                    <div class="winner-item"><span>#2</span><span>---</span><span>0 clicks</span></div>
                    <div class="winner-item"><span>#3</span><span>---</span><span>0 clicks</span></div>
                    <div class="winner-item"><span>#4</span><span>---</span><span>0 clicks</span></div>
                </div>
            </div>

            <!-- Offers Section -->
            <div class="offers-section" id="offersSection">
                <h3>📦 Subscription Plans</h3>
                <div class="offers-grid">
                    <div class="offer-card" data-days="1">
                        <span class="offer-days">1 Day</span>
                        <span class="offer-price">$1</span>
                        <button class="offer-btn">Subscribe</button>
                    </div>
                    <div class="offer-card" data-days="7">
                        <span class="offer-days">7 Days</span>
                        <span class="offer-price">$5</span>
                        <button class="offer-btn">Subscribe</button>
                    </div>
                    <div class="offer-card" data-days="14">
                        <span class="offer-days">14 Days</span>
                        <span class="offer-price">$10</span>
                        <button class="offer-btn">Subscribe</button>
                    </div>
                    <div class="offer-card" data-days="30">
                        <span class="offer-days">30 Days</span>
                        <span class="offer-price">$20</span>
                        <button class="offer-btn">Subscribe</button>
                    </div>
                </div>
            </div>

            <!-- Wallet Section -->
            <div class="wallet-section">
                <div class="wallet-actions">
                    <button class="wallet-btn" id="depositBtn">💰 Deposit</button>
                    <button class="wallet-btn" id="withdrawBtn">💳 Withdraw</button>
                </div>
                <div class="wallet-address" id="walletAddress">
                    <span>USDT TRC20:</span>
                    <span>TCKxV... (Set your wallet)</span>
                </div>
            </div>
        </main>

        <!-- Offer Modal -->
        <div class="modal" id="offerModal">
            <div class="modal-content">
                <span class="modal-close">&times;</span>
                <h3>Subscribe to Plan</h3>
                <p>You are subscribing to <span id="offerDaysDisplay">-</span> day(s) for <span id="offerPriceDisplay">-</span> $</p>
                <p>Send payment to this USDT TRC20 address:</p>
                <div class="payment-address" id="paymentAddress">TCKxV... (Set your wallet)</div>
                <button class="modal-btn" id="confirmOffer">Confirm Payment</button>
                <p class="modal-error" id="offerError"></p>
            </div>
        </div>

        <!-- Withdraw Modal -->
        <div class="modal" id="withdrawModal">
            <div class="modal-content">
                <span class="modal-close">&times;</span>
                <h3>Withdraw Funds</h3>
                <div class="form-group">
                    <label>Amount ($)</label>
                    <input type="number" id="withdrawAmount" placeholder="Amount" min="1">
                </div>
                <div class="form-group">
                    <label>USDT TRC20 Address</label>
                    <input type="text" id="withdrawAddress" placeholder="Enter USDT TRC20 address">
                </div>
                <button class="modal-btn" id="confirmWithdraw">Submit Request</button>
                <p class="modal-error" id="withdrawError"></p>
            </div>
        </div>

        <!-- Deposit Modal -->
        <div class="modal" id="depositModal">
            <div class="modal-content">
                <span class="modal-close">&times;</span>
                <h3>Deposit Funds</h3>
                <p>Send payment to this USDT TRC20 address:</p>
                <div class="payment-address" id="depositAddress">TCKxV... (Set your wallet)</div>
                <div class="form-group">
                    <label>Amount ($)</label>
                    <input type="number" id="depositAmount" placeholder="Amount" min="1">
                </div>
                <button class="modal-btn" id="confirmDeposit">Confirm Payment</button>
                <p class="modal-error" id="depositError"></p>
            </div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
